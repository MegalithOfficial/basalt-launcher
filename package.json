{
  "name": "basalt-launcher",
  "description": "A visually polished Minecraft launcher with practical instance and content management",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "author": "MegalithOfficial",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MegalithOfficial/basalt-launcher.git"
  },
  "bugs": {
    "url": "https://github.com/MegalithOfficial/basalt-launcher/issues"
  },
  "keywords": [
    "minecraft",
    "launcher",
    "tauri",
    "modrinth",
    "curseforge"
  ],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "BASALT_BUILD_CHANNEL=dev tauri dev",
    "dev:frontend": "vite",
    "build": "BASALT_BUILD_CHANNEL=release tauri build",
    "build:frontend": "tsc && vite build",
    "format": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "format:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "check": "bun run check:frontend && bun run check:rust",
    "check:frontend": "bun run build:frontend",
    "check:rust": "bun run format:check && cargo test --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "dompurify": "^3.4.11",
    "lucide-react": "^1.21.0",
    "motion": "^12.40.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "skinview3d": "^3.4.2",
    "sonner": "^2.0.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
