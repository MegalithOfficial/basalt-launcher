{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Basalt Launcher",
  "identifier": "com.megalithofficial.basalt-launcher",
  "build": {
    "beforeDevCommand": "bun run dev:frontend",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Basalt Launcher",
        "width": 1460,
        "height": 850,
        "minWidth": 1080,
        "minHeight": 700,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/media/**", "$APPDATA/instances/*/screenshots/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaW5pIHB1YmxpYyBrZXk6IDI2NDIwMUFEMzlFRDVBN0UKUldSK1d1MDVyUUZDSmxtYzgrVUE4cmpLbnE4Q1AwaFNzUnRVa0lQRE81L0lKMlQrMHpoOEhtTmgK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "publisher": "MegalithOfficial",
    "homepage": "https://github.com/MegalithOfficial/basalt-launcher",
    "copyright": "Copyright © 2026 MegalithOfficial",
    "category": "Game",
    "shortDescription": "A polished, functional Minecraft launcher.",
    "longDescription": "Basalt Launcher is a visually polished Minecraft launcher with practical instance and content management.",
    "linux": {
      "deb": {
        "desktopTemplate": "linux/single-main-window.desktop.hbs"
      },
      "rpm": {
        "desktopTemplate": "linux/single-main-window.desktop.hbs"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
